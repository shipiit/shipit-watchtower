# Watcher's local real-data dashboard
WATCHER_DASHBOARD_URL=http://localhost:3000
WATCHER_DASHBOARD_TOKEN=replace-with-the-token-from-npm-run-setup
WATCHER_SERVICE=my-agent
WATCHER_PROJECT=default
WATCHER_ENV=development
WATCHER_CONTENT_POLICY=redacted

# Set only the provider used by the selected example
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional example routing overrides
MODEL=openai/gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
CUSTOM_MODEL=acme-local-8b
CUSTOM_MODEL_URL=http://localhost:8000/v1/chat/completions
